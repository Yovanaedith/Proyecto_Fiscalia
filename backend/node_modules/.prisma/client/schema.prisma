generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Funcionario {
  id         Int     @id @default(autoincrement())
  nombre     String
  cargo      String
  ipAsignada String
  oficina    String
  telefono   String?
  estado     String?
}
